{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "railpack",
    "buildCommand": "composer install --no-dev"
  },
  "deploy": {
    "startCommand": "php artisan serve --host=0.0.0.0 --port=$PORT",
    "healthcheckPath": "/",
    "extensions": [
      "zip", 
      "pdo_mysql" 
    ],
    "environment": {
      "APP_ENV": "production",
      "APP_DEBUG": "false"
    }
  }
}